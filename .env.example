# Desktop API protection
ATELIER_API_TOKEN=

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-this-random-value
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v24.0

# Optional comma-separated WhatsApp user numbers, without + or spaces.
# Empty means every sender accepted by the connected business number.
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_MAX_DOWNLOAD_BYTES=104857600
WHATSAPP_MAX_IMAGE_BYTES=5242880
WHATSAPP_MAX_DOCUMENT_BYTES=104857600
